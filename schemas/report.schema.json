          "required": [
            "status",
            "reason",
            "evidence_refs"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "PASS"
                  }
                }
              },
              "then": {
                "properties": {

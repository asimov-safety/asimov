{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:asimov:0.2.0:assessment-report",
  "title": "Asimov assessment report",
  "description": "Schema validation is structural only; evidence and identity need separate verification.",
  "type": "object",
  "properties": {
    "spec_version": {
      "const": "0.2.0"

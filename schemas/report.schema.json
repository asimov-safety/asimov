      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "illustrative",
            "self_assessment",
            "independent_assessment"
          ]
        },
        "assessor": {
          "type": "string",
          "minLength": 1
        },
        "subject_organization": {
          "type": "string"
        },
        "assessor_organization": {
          "type": "string"
        }
      },
      "required": [
        "mode",
        "assessor"
      ],
      "additionalProperties": false
    },
    "system": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "configuration_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "configuration_sha256"
      ],
      "additionalProperties": false
    },

{
  "type": "object",
  "properties": {
    "spec_version": {
      "const": "0.2.0-draft.1"
    },
    "manifest_id": {
      "type": "string",
      "minLength": 1
    },
    "system": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "configuration_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "model_reference": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "immutable_version",
                "mutable_alias",
                "unknown",
                "none"
              ]
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "configuration_sha256",
        "model_reference"
      ],
      "additionalProperties": false
    },
    "boundary": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "deployment",
            "component"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "consequential_paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "enabled": {
                "type": "boolean"
              },
              "control_status": {
                "enum": [
                  "VERIFIED",
                  "CLAIMED",
                  "UNKNOWN",
                  "DISABLED"
                ]
              },
              "controller_ref": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "kind",
              "enabled",
              "control_status",
              "controller_ref"
            ],
            "additionalProperties": false
          }
        },
        "excluded_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "kind",
        "description",
        "consequential_paths",
        "excluded_paths"
      ],
      "additionalProperties": false
    },
    "trust_assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "human_authority": {
      "type": "object",
      "properties": {
        "operator_role": {
          "type": "string",
          "minLength": 1
        },
        "revoker_role": {
          "type": "string",
          "minLength": 1
        },
        "emergency_operator_role": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "operator_role",
        "revoker_role",
        "emergency_operator_role"
      ],
      "additionalProperties": false
    },
    "timing_plan": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "DRAFT",
            "REVIEWED"
          ]
        },
        "measurement_clock": {
          "type": "string",
          "minLength": 1
        },
        "limits": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "max_seconds": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "justification": {
                "type": "string",
                "minLength": 1
              },
              "review_evidence_ref": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "name",
              "max_seconds",
              "justification",
              "review_evidence_ref"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "status",
        "measurement_clock",
        "limits"
      ],
      "additionalProperties": false
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "spec_version",
    "manifest_id",
    "system",
    "boundary",
    "trust_assumptions",
    "human_authority",
    "timing_plan",
    "limitations"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:asimov:draft:0.2.0-draft.1:scope-manifest",
  "title": "Asimov draft deployment scope manifest",
  "description": "Schema validity does not establish coverage, authority, reviewed deadlines, or claim eligibility. Null limits and DRAFT plans cannot support a timing PASS."
}
